datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  EDITOR
}

enum ServiceType {
  RENTAL
  SALE
  RENTAL_AND_SALE
  INQUIRY
}

enum PriceType {
  FIXED
  STARTING_FROM
  CONTACT
  HIDDEN
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
}

enum BookingStatus {
  NEW
  CONTACTED
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EventType {
  PRODUCT_VIEW
  WHATSAPP_CLICK
  PHONE_CLICK
  BOOKING_CREATED
  CATEGORY_VIEW
  GALLERY_VIEW
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imagePath   String?    @map("image_path")
  isActive    Boolean    @default(true) @map("is_active")
  sortOrder   Int        @default(0) @map("sort_order")
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  products    Product[]

  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id                 String             @id @default(uuid())
  categoryId         String             @map("category_id")
  name               String
  slug               String             @unique
  shortDescription   String?            @map("short_description")
  description        String?
  serviceType        ServiceType        @default(RENTAL) @map("service_type")
  price              Decimal?           @db.Decimal(12, 2)
  priceType          PriceType          @default(CONTACT) @map("price_type")
  availabilityStatus AvailabilityStatus @default(AVAILABLE) @map("availability_status")
  isFeatured         Boolean            @default(false) @map("is_featured")
  isPublished        Boolean            @default(true) @map("is_published")
  viewsCount         Int                @default(0) @map("views_count")
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images             ProductImage[]
  bookingItems       BookingItem[]

  @@index([categoryId])
  @@index([slug])
  @@index([isPublished])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  imagePath String   @map("image_path")
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Booking {
  id                  String        @id @default(uuid())
  bookingNumber       String        @unique @map("booking_number")
  customerName        String        @map("customer_name")
  phone               String
  customerLocation    String?       @map("customer_location")
  eventType           String?       @map("event_type")
  eventDate           DateTime?     @map("event_date")
  rentalStartDate     DateTime?     @map("rental_start_date")
  rentalEndDate       DateTime?     @map("rental_end_date")
  daysCount           Int           @default(1) @map("days_count")
  notes               String?
  status              BookingStatus @default(NEW)
  totalEstimatedPrice Decimal?      @map("total_estimated_price") @db.Decimal(12, 2)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  items               BookingItem[]

  @@index([bookingNumber])
  @@index([status])
  @@index([phone])
  @@map("bookings")
}

model BookingItem {
  id              String    @id @default(uuid())
  bookingId       String    @map("booking_id")
  productId       String?   @map("product_id")
  productName     String    @map("product_name")
  quantity        Int       @default(1)
  unitPrice       Decimal?  @map("unit_price") @db.Decimal(12, 2)
  daysCount       Int       @default(1) @map("days_count")
  lineTotal       Decimal?  @map("line_total") @db.Decimal(12, 2)
  rentalStartDate DateTime? @map("rental_start_date")
  rentalEndDate   DateTime? @map("rental_end_date")
  notes           String?

  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([productId])
  @@map("booking_items")
}

model GalleryItem {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  description String?
  categoryTag String?        @map("category_tag")
  eventDate   DateTime?      @map("event_date")
  isPublished Boolean        @default(true) @map("is_published")
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  images      GalleryImage[]

  @@index([slug])
  @@index([isPublished])
  @@map("gallery_items")
}

model GalleryImage {
  id            String      @id @default(uuid())
  galleryItemId String      @map("gallery_item_id")
  imagePath     String      @map("image_path")
  altText       String?     @map("alt_text")
  sortOrder     Int         @default(0) @map("sort_order")
  isPrimary     Boolean     @default(false) @map("is_primary")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt  @map("updated_at")

  galleryItem   GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade)

  @@index([galleryItemId])
  @@map("gallery_images")
}

model Offer {
  id           String    @id @default(uuid())
  title        String
  description  String?
  imagePath    String?   @map("image_path")
  discountText String?   @map("discount_text")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("offers")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model AnalyticsEvent {
  id          String    @id @default(uuid())
  eventType   EventType @map("event_type")
  referenceId String?   @map("reference_id")
  metadata    String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([eventType])
  @@index([referenceId])
  @@map("analytics_events")
}
